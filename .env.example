# The narrator's key. Copy this file to .env.local for local development;
# .env.local is git-ignored and is read by the dev server's node process, never
# by the browser bundle. On Vercel, set the same name in Project Settings ->
# Environment Variables instead.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5
